{
	"name": "xmlxyz",
	"packageManager": "npm@11.17.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev --workspaces",
		"build": "npm run build --workspaces",
		"clean": "npm run clean --workspaces --if-present",
		"coverage": "npm run build && node --import tsx --test --experimental-test-coverage --test-coverage-include='packages/*/src/**/*.ts' --test-coverage-exclude='packages/*/src/generated/**' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=90 packages/*/test/*.test.ts",
		"test": "npm run test --workspaces",
		"typecheck": "npm run typecheck --workspaces",
		"benchmark": "npm run benchmark --workspaces --if-present",
		"format": "prettier --check .",
		"format:write": "prettier --write .",
		"pack:dry-run": "npm pack --workspaces --dry-run"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.0",
		"esbuild": "^0.28.2",
		"prettier": "^3.9.6",
		"tsx": "^4.23.12"
	},
	"prettier": {
		"printWidth": 95,
		"useTabs": true,
		"bracketSpacing": true,
		"bracketSameLine": true,
		"htmlWhitespaceSensitivity": "ignore"
	}
}

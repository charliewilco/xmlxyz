{
	"name": "@xmlxyz/xmlkit",
	"version": "0.0.1",
	"license": "Unlicense",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/charliewilco/xmlxyz.git",
		"directory": "packages/xmlkit"
	},
	"bugs": {
		"url": "https://github.com/charliewilco/xmlxyz/issues"
	},
	"homepage": "https://github.com/charliewilco/xmlxyz/tree/main/packages/xmlkit#readme",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "node ../../scripts/build.mjs",
		"clean": "node ../../scripts/clean.mjs",
		"dev": "node ../../scripts/build.mjs --watch",
		"bundle": "npm run build",
		"typecheck": "tsc --noEmit --pretty",
		"types": "npm run typecheck",
		"test": "node --import tsx --test test/*.test.ts",
		"benchmark": "node --import tsx benchmark/*.bench.ts"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"typescript": "7.0.2"
	}
}
